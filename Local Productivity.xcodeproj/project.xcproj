            "Boards/Model/BoardReport.swift",
            "Boards/Model/GoogleDriveMapping.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "MCP", "target-membership": [ "lp-mcp" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "LPWidgetsExtension", "Local Productivity" ] },

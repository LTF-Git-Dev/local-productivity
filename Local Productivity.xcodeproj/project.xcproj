        { "path": "<PRODUCTS>/LPWidgetsExtension.appex", "id": "ADA3D15E30AD543300B0765C", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Local Productivity/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },

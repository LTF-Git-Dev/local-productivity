        "LPWidgetsExtension",
      ],
      "membership-exceptions": [
        {
          "target": "LPWidgetsExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "LPWidgetsExtension/frameworks" ] },
        { "path": "/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "LPWidgetsExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/LP.app", "id": "ADE4885930AAEFEA00E7A4B9", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/LPUpdateInstaller.xpc", "id": "B1A5C0DE30C0FFEE00A1B2C3", "type": "wrapper.xpc-service", "index": false, "target-membership": [ { "build-phase": "Local Productivity/copy/Embed XPC Services", "header-preservation": "remove-on-copy" } ] },
